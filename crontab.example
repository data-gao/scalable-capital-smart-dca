# ==============================================================================
# Local Cron Configuration Example for Smart DCA
# ==============================================================================
# Edit your crontab using: crontab -e
# Ensure absolute paths and homebrew/bin are configured.

SHELL=/bin/bash
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# Example 1: Run daily inspection at 08:30 UTC on trading days (Monday to Friday)
30 8 * * 1-5 cd /path/to/scalable-capital-smart-dca && ./run_smart_dca.sh run --dry-run >> logs/cron.log 2>&1

# Example 2: Execute weekly savings plan rebalancing on Sunday evening (Live mode)
0 20 * * 0 cd /path/to/scalable-capital-smart-dca && ./run_smart_dca.sh run --live >> logs/cron_live.log 2>&1
